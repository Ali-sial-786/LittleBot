# LittleBot secrets - copy to `.env` and fill in only what you use.
# `.env` is git-ignored. Keys are read by the Python backend only and are
# never sent to the dashboard's browser JavaScript.
#
# Cloud AI is OFF by default. Even with a key here, a parent must enable
# cloud AI in the dashboard (AI page) before any request is made.

# Anthropic Claude API key (console.anthropic.com). A Claude Code / Claude.ai
# subscription does NOT include API access - this is a separate, paid account.
ANTHROPIC_API_KEY=

# OpenAI API key (platform.openai.com) - used for OpenAI chat, and optionally
# for cloud speech-to-text and text-to-speech.
OPENAI_API_KEY=

# TypeSafe API key (console.typesafe.ai) - for Jev, the fast decision model
# (littlebot/decide, docs/DECISIONS.md). Nothing is sent until a parent picks
# "TypeSafe Jev" under Fast decisions on the dashboard's AI page. The OpenAI key
# above works for OpenAI's Decisions API the same way.
TYPESAFE_API_KEY=

# Operating mode override: simulation | pi | offline
# LITTLEBOT_MODE=simulation

# Any config value can be overridden with LITTLEBOT__<SECTION>__<KEY>, e.g.
# LITTLEBOT__DASHBOARD__PORT=8080
# LITTLEBOT__LOGGING__LEVEL=DEBUG
